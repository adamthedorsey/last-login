{
  "name": "last-login",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:local": "VITE_GAME_BACKEND= vite --port 5174",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "gen:seed": "tsx scripts/validate-content.ts && tsx scripts/story-sync.ts && tsx scripts/generate-seed.ts && tsx scripts/clue-graph.ts",
    "check:bundle": "node scripts/check-bundle.mjs",
    "verify": "npm run validate && npm run story && npm run build && npm run test && npm run check:bundle",
    "validate": "tsx scripts/validate-content.ts",
    "story": "tsx scripts/story-sync.ts",
    "graph": "tsx scripts/clue-graph.ts"
  },
  "dependencies": {
    "@emotion/is-prop-valid": "^1.4.0",
    "@react95/icons": "^2.5.3",
    "@south-paw/typeface-fixed-system-excelsior": "^1.0.0",
    "@supabase/supabase-js": "^2.112.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react95": "^4.0.0",
    "styled-components": "^6.5.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/styled-components": "^5.1.36",
    "@vitejs/plugin-react": "^6.1.0",
    "oxlint": "^1.79.0",
    "tsx": "^4.23.12",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
