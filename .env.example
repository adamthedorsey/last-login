# Backend selection for `npm run dev`:
#   (unset)     -> dev mode: in-browser engine, no Supabase needed (DEV BUILDS ONLY)
#   supabase    -> talk to the Supabase Edge Function (local stack or hosted)
VITE_GAME_BACKEND=

# Required when VITE_GAME_BACKEND=supabase (and always in production builds).
# Use ONLY the publishable/anon key here. NEVER the service-role key.
VITE_SUPABASE_URL=http://127.0.0.1:55421
VITE_SUPABASE_PUBLISHABLE_KEY=
